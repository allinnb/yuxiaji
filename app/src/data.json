{
 "source": "《玉匣记·杂占篇》，维基文库整理本（zh.wikisource.org，PD-old），2025-12-31 版",
 "signs": [
  {
   "id": "mianre",
   "name": "面热",
   "title": "占面热法",
   "sides": false,
   "entries": [
    {
     "zhi": "子",
     "text": "主喜庆事，又主得财。",
     "tag": "吉"
    },
    {
     "zhi": "丑",
     "text": "主有烦恼、忧愁之事。",
     "tag": "慎"
    },
    {
     "zhi": "寅",
     "text": "主有客来聚会，大吉。",
     "tag": "吉"
    },
    {
     "zhi": "卯",
     "text": "主有酒食及外人至。",
     "tag": "吉"
    },
    {
     "zhi": "辰",
     "text": "主有远务喜相逢，吉。",
     "tag": "吉"
    },
    {
     "zhi": "巳",
     "text": "主有急事人来相见。",
     "tag": "吉"
    },
    {
     "zhi": "午",
     "text": "主亲来相见，命同坐。",
     "tag": "吉"
    },
    {
     "zhi": "未",
     "text": "主有词讼口舌是非。",
     "tag": "慎"
    },
    {
     "zhi": "申",
     "text": "主有高人会道相见。",
     "tag": "吉"
    },
    {
     "zhi": "酉",
     "text": "主有高人来会相见。",
     "tag": "吉"
    },
    {
     "zhi": "戌",
     "text": "主有酒食不叫自来。",
     "tag": "吉"
    },
    {
     "zhi": "亥",
     "text": "主官词讼及不宁事。",
     "tag": "慎"
    }
   ]
  },
  {
