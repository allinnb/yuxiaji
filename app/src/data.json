     "right": "主大吉",
     "left_tag": "平",
     "right_tag": "吉"
    },
    {
     "zhi": "酉",
     "text": "左主失财，右主大吉。",
     "left": "主失财",
     "right": "主大吉",
     "left_tag": "慎",
     "right_tag": "吉"
    },
    {
     "zhi": "戌",
     "text": "左主酒食，右主客至。",
     "left": "主酒食",
     "right": "主客至",
     "left_tag": "吉",
     "right_tag": "吉"
    },
    {
     "zhi": "亥",
     "text": "左主大吉，右主酒食。",
     "left": "主大吉",
     "right": "主酒食",
     "left_tag": "吉",
     "right_tag": "吉"
    }
   ]
  },
  {
   "id": "tipen",
   "name": "喷嚏",
   "title": "占嚏喷法",
   "sides": false,
   "entries": [
    {
     "zhi": "子",
     "text": "主逢吉人，酒食相会。",
     "tag": "吉"
    },
    {
     "zhi": "丑",
     "text": "女人默息，客人求事。",
     "tag": "吉"
    },
    {
     "zhi": "寅",
     "text": "主女人相遇，有酒食。",
     "tag": "吉"
    },
    {
     "zhi": "卯",
     "text": "主财。喜，有客来。同事，",
     "tag": "吉"
    },
    {
     "zhi": "辰",
     "text": "主人有酒食，大吉利。",
     "tag": "吉"
    },
    {
     "zhi": "巳",
     "text": "主有吉人来求财，喜。",
     "tag": "吉"
    },
    {
     "zhi": "午",
     "text": "主有各旅、酒会、宴饮。",
     "tag": "吉"
    },
    {
     "zhi": "未",
     "text": "主酒食相会合之事。",
     "tag": "吉"
    },
    {
     "zhi": "申",
     "text": "夜梦惊恐，酒食不利。",
     "tag": "慎"
    },
    {
     "zhi": "酉",
     "text": "主妇人来求请问事。",
     "tag": "平"
    },
    {
     "zhi": "戌",
     "text": "主妇人思会和合事。",
     "tag": "平"
    },
    {
     "zhi": "亥",
     "text": "主有虚惊，反得吉利。",
     "tag": "平"
    }
   ]
  },
  {
