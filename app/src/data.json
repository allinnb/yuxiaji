 "xiaoliuren": {
  "title": "李淳风六壬时课",
  "method": "每从“大安”上起正月，月上起日，日上起时。假如三月初五日辰时，三月在“速喜”上，就“速喜”上起初一，初五在“大安”，“大安”上起子时，数至辰时是“小吉”，就以“小吉”推占。馀皆仿此。",
  "formula": "index = (农历月-1 + 农历日-1 + 时支序号) % 6，序：大安、留连、速喜、赤口、小吉、空亡；子=0…亥=11；闰月按本月",
  "palaces": [
   {
    "name": "大安",
    "phrase": "身不动时",
    "wuxing": "木",
    "shen": "青龙",
    "numbers": "一、五、七",
    "verse": "大安事事昌，求谋在神方，失物去不远，宅舍保安康，行人身未动，病者主无妨，将军回田野，仔细与推详。",
    "tag": "吉"
   },
   {
    "name": "留连",
    "phrase": "卒未归时",
    "wuxing": "水",
    "shen": "玄武",
    "numbers": "二、八、十",
    "verse": "留连事难成，求谋日未明，官事只宜缓，去者未回程，失物南方见，急讨方称心，更须防口舌，人口且平平。",
    "tag": "平"
   },
   {
    "name": "速喜",
    "phrase": "人便至时",
    "wuxing": "火",
    "shen": "朱雀",
    "numbers": "三、六、九",
    "verse": "速喜喜来临，求财向南行，失物申未午，逢人路上寻，官事有福德，病者无祸侵，田宅六畜吉，行人有信音。",
    "tag": "吉"
   },
   {
    "name": "赤口",
    "phrase": "官事凶时",
    "wuxing": "金",
    "shen": "白虎",
    "numbers": "四、七、十",
    "verse": "赤口主口舌，官非切要防，失物急去寻，行人有惊慌，鸡犬多作怪，病者出西方，更须防咒诅，恐怕染瘟癀。",
    "tag": "凶"
   },
   {
    "name": "小吉",
    "phrase": "人来喜时",
    "wuxing": "木",
    "shen": "六合",
    "numbers": "一、五、七",
    "verse": "小吉最吉昌，路上好商量，阴人来报喜，失物在坤方，行人立便至，交关甚是强，凡事皆和合，病者祷上苍。",
    "tag": "吉"
   },
   {
    "name": "空亡",
    "phrase": "信音稀时",
    "wuxing": "土",
    "shen": "勾陈",
    "numbers": "一、五、七",
    "verse": "空亡事不长，阴人小乖张，求财无利益，行人有灾殃，失物寻不见，官事有刑伤，病人逢暗鬼，禳解保安康。",
    "tag": "凶"
   }
  ]
 },
 "zongheng": {
  "title": "出行紧急用四纵五横法",
  "steps": [
   "正身，齐足，立于门内",
   "叩齿三十六通",
   "以左手大拇指先画四纵，后画五横"
  ],
  "incantation": "四纵五横。吾今出行，禹王卫道，蚩尤避兵，盗贼不得起，虎狼不得侵，行远归故乡。当吾者死，背吾者亡，急急如九天玄女律令。",
  "after": "咒毕便行，慎勿反顾。每出行，将咒念七遍，画地，却以土块压之，自然吉矣。",
  "variant": "《增广玉匣记通书》作“右手大拇指”，题作“可行紧急不暇择日，当作纵横法”"
 },
 "directions": {
