   "name": "肉颤",
   "title": "占肉颤法",
   "sides": false,
   "entries": [
    {
     "zhi": "子",
     "text": "主有尊长人来，大吉。",
     "tag": "吉"
    },
    {
     "zhi": "丑",
     "text": "主有吉祥临身，大吉。",
     "tag": "吉"
    },
    {
     "zhi": "寅",
     "text": "主有凶事，化凶为吉。",
     "tag": "平"
    },
    {
     "zhi": "卯",
     "text": "主有得财事，大吉利。",
     "tag": "吉"
    },
    {
     "zhi": "辰",
     "text": "主有凶恶临身，大凶。",
     "tag": "慎"
    },
    {
     "zhi": "巳",
     "text": "主宾友相见，大吉利。",
     "tag": "吉"
    },
    {
     "zhi": "午",
     "text": "主有忧疑事，自身吉。",
     "tag": "平"
    },
    {
