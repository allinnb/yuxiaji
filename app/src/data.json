     "right": "主亲来",
     "left_tag": "吉",
     "right_tag": "吉"
    },
    {
     "zhi": "戌",
     "text": "左主酒食，右主聚财。",
     "left": "主酒食",
     "right": "主聚财",
     "left_tag": "吉",
     "right_tag": "吉"
    },
    {
     "zhi": "亥",
     "text": "左主有客，右主官事。",
     "left": "主有客",
     "right": "主官事",
     "left_tag": "吉",
     "right_tag": "慎"
    }
   ]
  },
  {
