     "text": "主有酒食宴乐事，吉。",
     "tag": "吉"
    },
    {
     "zhi": "酉",
     "text": "主有女子至、婚姻事。",
     "tag": "平"
    },
    {
     "zhi": "戌",
     "text": "主有争讼口舌之事。",
     "tag": "慎"
    },
    {
     "zhi": "亥",
     "text": "主有口舌词议之事。",
     "tag": "慎"
    }
   ]
  },
  {
