     "text": "主有喜事，占身大吉。",
     "tag": "吉"
    },
    {
     "zhi": "申",
     "text": "主有口舌，解之则吉。",
     "tag": "平"
    },
    {
     "zhi": "酉",
     "text": "主因财起祸事，大凶。",
     "tag": "慎"
    },
    {
     "zhi": "戌",
     "text": "主有行人远来，大吉。",
     "tag": "吉"
    },
    {
     "zhi": "亥",
     "text": "主有大吉利、喜之事。",
     "tag": "吉"
    }
   ]
