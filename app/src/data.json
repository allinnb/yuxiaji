     "left_tag": "吉",
     "right_tag": "吉"
    },
    {
     "zhi": "辰",
     "text": "左客人来，右损害事。",
     "left": "客人来",
     "right": "损害事",
     "left_tag": "吉",
     "right_tag": "慎"
    },
    {
     "zhi": "巳",
     "text": "左主酒食，右主凶事。",
     "left": "主酒食",
     "right": "主凶事",
     "left_tag": "吉",
     "right_tag": "慎"
    },
    {
     "zhi": "午",
     "text": "左主饮食，右主凶事。",
